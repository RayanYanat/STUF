# Copy this file to ".env" (which is git-ignored) and fill in real values.
# netlify dev loads ".env" automatically and injects these into the function.

# --- Chat assistant LLM (swappable, OpenAI-compatible API) ------------------
# PRODUCTION: a PAID, no-training account, charity-owned (OpenAI default below).
#   LLM_API_KEY=sk-...           LLM_MODEL=gpt-4o-mini   (LLM_BASE_URL can stay empty)
# FREE DEMO (your test messages only — no real user data, so the free tiers are fine):
#   Groq:   LLM_API_KEY=gsk_...  LLM_BASE_URL=https://api.groq.com/openai/v1                       LLM_MODEL=llama-3.3-70b-versatile
#   Gemini: LLM_API_KEY=...      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-3-flash
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Resend API key — https://resend.com (free tier: 100 emails/day).
# Create a key in the Resend dashboard once you've signed up.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where advice submissions are delivered (the charity's team inbox).
ADVICE_TO_EMAIL=team@stuf.org.uk

# Verified sender address.
# - Local testing: use Resend's sandbox sender below (delivers to the Resend
#   account owner's own email only).
# - Production: a verified domain — the charity's domain or a neutral one.
#   Must NOT be a personal/business domain.
ADVICE_FROM_EMAIL=onboarding@resend.dev
